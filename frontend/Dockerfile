FROM node:lts-alpine as build-prod
WORKDIR /wikiadviser-frontend
COPY . .

ARG SUPABASE_PROJECT_URL_PROD
ARG SUPABASE_ANON_KEY_PROD
ARG MEDIAWIKI_ENDPOINT_PROD
ARG SENTRY_DSN_FRONTEND_PROD
ARG SENTRY_ENV_FRONTEND_PROD
ARG USE_MIRA_PROD
ARG USE_CHANGE_DESCRIPTION_PROD
ARG WIKIADVISER_LANGUAGES
ARG SHARE_LINK_DAY_LIMIT
ARG POSTHOG_API_KEY
ARG POSTHOG_API_HOST

ENV SUPABASE_PROJECT_URL ${SUPABASE_PROJECT_URL_PROD}
ENV SUPABASE_ANON_KEY ${SUPABASE_ANON_KEY_PROD}
ENV MEDIAWIKI_ENDPOINT ${MEDIAWIKI_ENDPOINT_PROD}
ENV WIKIADVISER_LANGUAGES ${WIKIADVISER_LANGUAGES}
ENV SHARE_LINK_DAY_LIMIT ${SHARE_LINK_DAY_LIMIT}
ENV SENTRY_DSN_FRONTEND ${SENTRY_DSN_FRONTEND_PROD}
ENV SENTRY_ENV_FRONTEND ${SENTRY_ENV_FRONTEND_PROD}
ENV POSTHOG_API_KEY ${POSTHOG_API_KEY}
ENV POSTHOG_API_HOST ${POSTHOG_API_HOST}
ENV USE_MIRA ${USE_MIRA_PROD}
ENV USE_CHANGE_DESCRIPTION ${USE_CHANGE_DESCRIPTION_PROD}

RUN npm install -g pnpm
RUN yes | pnpm approve-builds
RUN pnpm install && pnpm run build

FROM node:lts-alpine as build-qa
WORKDIR /wikiadviser-frontend
COPY . .

ARG SUPABASE_PROJECT_URL_QA
ARG SUPABASE_ANON_KEY_QA
ARG MEDIAWIKI_ENDPOINT_QA
ARG SENTRY_DSN_FRONTEND_QA
ARG SENTRY_ENV_FRONTEND_QA
ARG USE_MIRA_QA
ARG USE_CHANGE_DESCRIPTION_QA
ARG WIKIADVISER_LANGUAGES
ARG SHARE_LINK_DAY_LIMIT
ARG POSTHOG_API_KEY
ARG POSTHOG_API_HOST

ENV SUPABASE_PROJECT_URL ${SUPABASE_PROJECT_URL_QA}
ENV SUPABASE_ANON_KEY ${SUPABASE_ANON_KEY_QA}
ENV MEDIAWIKI_ENDPOINT ${MEDIAWIKI_ENDPOINT_QA}
ENV WIKIADVISER_LANGUAGES ${WIKIADVISER_LANGUAGES}
ENV SHARE_LINK_DAY_LIMIT ${SHARE_LINK_DAY_LIMIT}
ENV SENTRY_DSN_FRONTEND ${SENTRY_DSN_FRONTEND_QA}
ENV SENTRY_ENV_FRONTEND ${SENTRY_ENV_FRONTEND_QA}
ENV POSTHOG_API_KEY ${POSTHOG_API_KEY}
ENV POSTHOG_API_HOST ${POSTHOG_API_HOST}
ENV USE_MIRA ${USE_MIRA_QA}
ENV USE_CHANGE_DESCRIPTION ${USE_CHANGE_DESCRIPTION_QA}

RUN npm install -g pnpm
RUN yes | pnpm approve-builds
RUN pnpm install && pnpm run build

FROM caddy:2.8.0-alpine as production-stage
COPY --from=build-prod /wikiadviser-frontend/dist/spa /usr/share/caddy/html-prod
COPY --from=build-qa /wikiadviser-frontend/dist/spa /usr/share/caddy/html-qa
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile"]