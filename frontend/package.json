{
  "name": "frontend-quasar",
  "version": "0.0.1",
  "description": "Make Wikipedia easy to edit by helping you follow Wikipedia body of rules",
  "productName": "WikiAdviser",
  "author": "Jaafoura <mehdi.jaafourag@gmail.com>",
  "private": true,
  "scripts": {
    "install-deps": "pnpm i",
    "lint": "eslint . --ext .js,.ts,.vue",
    "lint:fix": "pnpm run lint --fix",
    "prettier": "prettier --check \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "prettier:fix": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"See package.json => scripts for available tests.\" && exit 0",
    "dev": "quasar dev",
    "build": "quasar build"
  },
  "dependencies": {
    "@quasar/cli": "^5.0.8",
    "@quasar/extras": "^2.1.0",
    "@sentry/vue": "^10.75.2",
    "@supabase/ssr": "^0.12.7",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.2",
    "pinia": "^2.1.7",
    "posthog-js": "^1.434.7",
    "quasar": "^2.33.1",
    "vue": "^3.5.43",
    "vue-router": "^4.2.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nuxtbase/auth-ui-vue": "^0.3.6",
    "@quasar/app-vite": "^2.6.2",
    "@supabase/auth-ui-shared": "^0.1.8",
    "@supabase/supabase-js": "^2.117.0",
    "@types/node": "^26.6.2",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^6.18.1",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^9.33.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": "^24 || ^22",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1",
    "pnpm": ">= 9.15.9"
  }
}
